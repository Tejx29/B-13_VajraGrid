# GEMINI_FREE_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_FREE_KEY is checked first (allowing custom free-tier secrets), falling back to GEMINI_API_KEY.
# Users configure this via the Secrets panel in the AI Studio UI or server environment.
# GEMINI_FREE_KEY="your_custom_gemini_api_key"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Geocoding Provider Configuration (Optional)
# Default provider is "nominatim" (OpenStreetMap public search on explicit submit, no client-side keystroke autocomplete).
# To enable real-time autocomplete search, configure Geoapify or LocationIQ:
VITE_GEOCODING_PROVIDER="nominatim"
# VITE_GEOAPIFY_API_KEY="your_geoapify_api_key_here"
# VITE_LOCATIONIQ_API_KEY="your_locationiq_api_key_here"
# NASA FIRMS (Fire Information for Resource Management System) Configuration (Optional)
# Server-side MAP_KEY for near-real-time satellite thermal hotspot observations (NOAA-20 / NOAA-21 VIIRS, MODIS).
# Obtain a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Stored on server only; never exposed to browser client.
NASA_MAP_KEY="MY_NASA_MAP_KEY"
